# Entorno de la aplicación
FLASK_ENV=development

# Configuración de la base de datos
# Para Docker: usa 'db' como host
# Para local: usa 'localhost'
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/inventarios_db
POSTGRES_DB=inventarios_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
HOST_POSTGRES_PORT=5434

# URL de la fábrica externa
# Por defecto, apunta al servicio local de fábrica levantado con Docker en el host
FABRICA_BASE_URL=http://host.docker.internal:8555
FABRICA_BASE_URL_FALLBACK=http://host.docker.internal:8555
# Opcional: cambia a la URL externa (ej. AWS) si la fábrica está desplegada fuera del host
# FABRICA_BASE_URL=http://ec2-98-93-67-35.compute-1.amazonaws.com:8555

# URL que la fábrica externa usará para enviar productos terminados
# IMPORTANTE: Debe ser accesible desde la fábrica externa
# Opciones:
# - Si estás en la misma red: http://<TU_IP_LOCAL>:5050/api/fabricacion/webhook/productos_terminados
# - Si usas ngrok: http://<NGROK_URL>/api/fabricacion/webhook/productos_terminados
# - Valor por defecto (solo funciona dentro de Docker): http://host.docker.internal:5050/api/fabricacion/webhook/productos_terminados
# Formato: http://<TU_IP_PUBLICA>:5050/api/fabricacion/webhook/productos_terminados
WEBHOOK_CALLBACK_URL=http://TU_IP_PUBLICA:5050/api/fabricacion/webhook/productos_terminados
