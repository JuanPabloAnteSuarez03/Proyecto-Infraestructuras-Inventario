FLASK_ENV=development

# Database connection (used by API/worker)
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/inventarios_db
POSTGRES_DB=inventarios_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
HOST_POSTGRES_PORT=5434

# External factory base URL (container reaches host through host.docker.internal)
FABRICA_BASE_URL=http://ec2-98-93-67-35.compute-1.amazonaws.com:8555
FABRICA_BASE_URL_FALLBACK=http://ec2-98-93-67-35.compute-1.amazonaws.com:8555

# Where the factory would send finished products (kept for completeness)
WEBHOOK_CALLBACK_URL=http://ec2-44-197-195-198.compute-1.amazonaws.com:5050/api/fabricacion/webhook/productos_terminados

# Auto-restock settings
AUTO_RESTOCK_INTERVAL=5